{
  "name": "playback-controls-for-youtube-tm",
  "version": "0.3.11",
  "private": true,
  "type": "module",
  "description": "Playback Controls for Youtube™ adds quick playback speed, seek, quality, captions, and style controls to YouTube.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LisandroNahuelH/playback-controls-for-youtube.git"
  },
  "homepage": "https://chromewebstore.google.com/detail/lmelkfedknejbehkbmoehdmnmoloaflo",
  "bugs": {
    "url": "https://github.com/LisandroNahuelH/playback-controls-for-youtube/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "i18n:bootstrap-locale": "node scripts/bootstrap-i18n-locale.mjs",
    "i18n:bootstrap-all": "node scripts/bootstrap-all-locales.mjs",
    "i18n:generate": "node scripts/generate-i18n-types.mjs",
    "i18n:check": "node scripts/check-i18n.mjs && node scripts/i18n/audit-title-case.mjs",
    "i18n:audit": "node scripts/audit-i18n-literals.mjs",
    "build": "npm run i18n:generate && npm run i18n:check && npm run i18n:audit && vite build",
    "test": "npm run i18n:generate && vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run i18n:generate && tsc --noEmit",
    "verify": "npm run i18n:check && npm run i18n:audit && npm test && npm run typecheck && npm run build",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.32",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.15.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
